#!/bin/bash
#
# This script fires up a two-server IRC network and runs the test framework
#

# Exit on error:
set -e

# Verbose:
set -x

# Kill old instances
killall -9 zenircd unrealircd || true

# Compatibility for the UnrealIRCd test harness, which expects ~/unrealircd
# and unrealircd binary/pid names. ZenIRCd installs to ~/zenircd.
if [ -d "$HOME/zenircd" ]; then
	ln -sfn "$HOME/zenircd" "$HOME/unrealircd"
	mkdir -p "$HOME/zenircd/data" "$HOME/zenircd/conf" "$HOME/zenircd/bin"
	# Pid file name differs; dangling symlink is fine until the daemon starts.
	ln -sfn zenircd.pid "$HOME/zenircd/data/unrealircd.pid"
	if [ -e "$HOME/zenircd/zenircd" ] && [ ! -e "$HOME/zenircd/unrealircd" ]; then
		ln -sfn zenircd "$HOME/zenircd/unrealircd"
	fi
	if [ -e "$HOME/zenircd/bin/zenircd" ] && [ ! -e "$HOME/zenircd/bin/unrealircd" ]; then
		ln -sfn zenircd "$HOME/zenircd/bin/unrealircd"
	fi
	if [ -e "$HOME/zenircd/conf/zenircd.conf" ] && [ ! -e "$HOME/zenircd/conf/unrealircd.conf" ]; then
		ln -sfn zenircd.conf "$HOME/zenircd/conf/unrealircd.conf"
	fi
fi

# Upstream UnrealIRCd tests (no Zen-specific fork yet).
# Paths still use ~/unrealircd via the symlinks above; only rebrand user-facing text.
rm -rf unrealircd-tests/
git clone -q --branch unreal60 https://github.com/unrealircd/unrealircd-tests.git unrealircd-tests
cd unrealircd-tests
# The harness hardcodes "UnrealIRCd" in fail/help strings (e.g. start errors).
find . -type f \( -name 'run' -o -name '*.py' -o -name '*.md' -o -name 'wrapper' \) \
	-exec sed -i \
		-e 's/UnrealIRCd/ZenIRCd/g' \
		-e 's/unrealircd-tests/zenircd-tests/g' \
		{} +

# FreeBSD has various issues with the tests from us and others,
# better set a flag to keep it simple:
if uname -a|grep -q FreeBSD; then
	NOSERVICES=1
fi

# Run the test framework, testing both services:
if [ "$NOSERVICES" = 1 ]; then
	./run -services none $RUNTESTFLAGS || exit 1
else
	# Linux tests both with anope and atheme services:
	./run -services anope $RUNTESTFLAGS || exit 1
	./run -services atheme $RUNTESTFLAGS || exit 1
fi

# Database writing/reading tests
## unencrypted:
./run -services none -boot tests/db/writing/* || exit 1
./run -services none -keepdbs -boot tests/db/reading/* || exit 1
## encrypted:
./run -services none -include db_crypted.conf -boot tests/db/writing/* || exit 1
./run -services none -include db_crypted.conf -keepdbs -boot tests/db/reading/* || exit 1

echo "If you also want to run the SSL/TLS tests, see extras/tests/tls/tls-tests"
